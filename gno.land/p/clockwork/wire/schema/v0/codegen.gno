package schema

import (
	"errors"
	"strings"
)

// GenerateGno emits Gno source for pkg: one struct per message, in
// canonical (sorted) field order, plus MarshalWire/Unmarshal functions built
// on gno.land/p/clockwork/wire/v0. Nested messages and slices compose through
// internal marshalTo/read helpers, so arbitrarily deep shapes generate
// correctly.
//
// The same schema drives a generator in any other language by following the
// same two rules: fields in name-sorted order, and the wire encoding per kind
// listed in the wire package. This is the gno reference generator.
func GenerateGno(s *Schema, pkg string) (string, error) {
	if err := s.Validate(); err != nil {
		return "", err
	}
	var b strings.Builder
	b.WriteString("// Code generated by wire/schema. DO NOT EDIT.\n\n")
	b.WriteString("package " + pkg + "\n\n")
	b.WriteString("import (\n\t\"errors\"\n\n\t\"gno.land/p/clockwork/wire/v0\"\n)\n")

	for _, m := range s.Messages() {
		genMessage(&b, m)
	}
	return b.String(), nil
}

func genMessage(b *strings.Builder, m *Message) {
	fields := m.Fields()
	name := title(m.Name)

	// struct
	b.WriteString("\ntype " + name + " struct {\n")
	width := 0
	for _, f := range fields {
		if n := len(title(f.Name)); n > width {
			width = n
		}
	}
	for _, f := range fields {
		fn := title(f.Name)
		b.WriteString("\t" + fn)
		for p := len(fn); p < width; p++ {
			b.WriteString(" ")
		}
		b.WriteString(" " + gnoType(f) + "\n")
	}
	b.WriteString("}\n")

	// marshalTo + MarshalWire
	b.WriteString("\nfunc (m " + name + ") marshalTo(w *wire.Writer) {\n")
	for _, f := range fields {
		b.WriteString(genEncode(f))
	}
	b.WriteString("}\n")
	b.WriteString("\nfunc (m " + name + ") MarshalWire() []byte {\n")
	b.WriteString("\tw := wire.NewWriter()\n\tm.marshalTo(w)\n\treturn w.Bytes()\n}\n")

	// read + Unmarshal
	b.WriteString("\nfunc read" + name + "(r *wire.Reader) " + name + " {\n\tvar m " + name + "\n")
	for _, f := range fields {
		b.WriteString(genDecode(f))
	}
	b.WriteString("\treturn m\n}\n")
	b.WriteString("\nfunc Unmarshal" + name + "(b []byte) (" + name + ", error) {\n")
	b.WriteString("\tr := wire.NewReader(b)\n\tm := read" + name + "(r)\n")
	b.WriteString("\tif r.Err() != nil {\n\t\treturn " + name + "{}, r.Err()\n\t}\n")
	b.WriteString("\tif !r.Done() {\n\t\treturn " + name + "{}, errors.New(\"wire: trailing bytes for " + name + "\")\n\t}\n")
	b.WriteString("\treturn m, nil\n}\n")
}

func genEncode(f Field) string {
	t := title(f.Name)
	switch f.Kind {
	case Msg:
		return "\tm." + t + ".marshalTo(w)\n"
	case List:
		var b strings.Builder
		b.WriteString("\tw.Uvarint(uint64(len(m." + t + ")))\n")
		b.WriteString("\tfor _, e := range m." + t + " {\n")
		if f.Elem == Msg {
			b.WriteString("\t\te.marshalTo(w)\n")
		} else {
			b.WriteString("\t\tw." + wireMethod(f.Elem) + "(e)\n")
		}
		b.WriteString("\t}\n")
		return b.String()
	default:
		return "\tw." + wireMethod(f.Kind) + "(m." + t + ")\n"
	}
}

func genDecode(f Field) string {
	t := title(f.Name)
	switch f.Kind {
	case Msg:
		return "\tm." + t + " = read" + title(f.Ref) + "(r)\n"
	case List:
		elemT := gnoElemType(f)
		var read string
		if f.Elem == Msg {
			read = "read" + title(f.Ref) + "(r)"
		} else {
			read = "r." + wireMethod(f.Elem) + "()"
		}
		var b strings.Builder
		b.WriteString("\t{\n")
		b.WriteString("\t\tn := r.Uvarint()\n")
		b.WriteString("\t\tc := n\n")
		b.WriteString("\t\tif c > uint64(r.Remaining()) {\n\t\t\tc = uint64(r.Remaining())\n\t\t}\n")
		b.WriteString("\t\tm." + t + " = make([]" + elemT + ", 0, c)\n")
		b.WriteString("\t\tfor k := uint64(0); k < n; k++ {\n")
		b.WriteString("\t\t\tif r.Err() != nil {\n\t\t\t\tbreak\n\t\t\t}\n")
		b.WriteString("\t\t\tm." + t + " = append(m." + t + ", " + read + ")\n")
		b.WriteString("\t\t}\n\t}\n")
		return b.String()
	default:
		return "\tm." + t + " = r." + wireMethod(f.Kind) + "()\n"
	}
}

// gnoType renders a field's Gno type.
func gnoType(f Field) string {
	switch f.Kind {
	case Msg:
		return title(f.Ref)
	case List:
		return "[]" + gnoElemType(f)
	default:
		return gnoScalarType(f.Kind)
	}
}

func gnoElemType(f Field) string {
	if f.Elem == Msg {
		return title(f.Ref)
	}
	return gnoScalarType(f.Elem)
}

func gnoScalarType(k Kind) string {
	switch k {
	case Bool:
		return "bool"
	case Byte:
		return "byte"
	case Int, Varint:
		return "int64"
	case Uint, Uvarint:
		return "uint64"
	case String:
		return "string"
	case Bytes:
		return "[]byte"
	case Address:
		return "address"
	}
	return "invalid"
}

// wireMethod is the wire.Writer/Reader method suffix for a scalar kind.
func wireMethod(k Kind) string {
	switch k {
	case Bool:
		return "Bool"
	case Byte:
		return "Byte"
	case Int:
		return "Int"
	case Uint:
		return "Uint"
	case Varint:
		return "Varint"
	case Uvarint:
		return "Uvarint"
	case String:
		return "Str"
	case Bytes:
		return "Blob"
	case Address:
		return "Addr"
	}
	return ""
}

var _ = errors.New
